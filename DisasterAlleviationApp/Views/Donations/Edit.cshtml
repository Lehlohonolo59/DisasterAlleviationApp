@model DisasterAlleviationApp.Models.Donation
<!-- Declares that this view receives a single Donation model object to populate and edit existing record values -->
@{
    ViewData["Title"] = "Edit"; // Sets the browser tab title to "Edit"
}

<h1>Edit</h1>
<h4>Donation</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <!-- asp-action="Edit" targets the POST Edit action method inside DonationsController upon saving changes -->
        <form asp-action="Edit">
            <!-- Displays any general model-level validation errors -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden input that carries the record's primary key ID so the controller knows which entry to update -->
            <input type="hidden" asp-for="Id" />

            <!-- Input group pre-loaded with the current Donor Name value for modification -->
            <div class="form-group">
                <label asp-for="DonorName" class="control-label"></label>
                <input asp-for="DonorName" class="form-control" />
                <span asp-validation-for="DonorName" class="text-danger"></span>
            </div>

            <!-- Input group pre-loaded with the current Donation Type value -->
            <div class="form-group">
                <label asp-for="DonationType" class="control-label"></label>
                <input asp-for="DonationType" class="form-control" />
                <span asp-validation-for="DonationType" class="text-danger"></span>
            </div>

            <!-- Input group pre-loaded with the current Amount/Quantity value -->
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <!-- Input group pre-loaded with the current Disaster Location value -->
            <div class="form-group">
                <label asp-for="DisasterLocation" class="control-label"></label>
                <input asp-for="DisasterLocation" class="form-control" />
                <span asp-validation-for="DisasterLocation" class="text-danger"></span>
            </div>

            <!-- Input group pre-loaded with the current Donation Date value -->
            <div class="form-group">
                <label asp-for="DonationDate" class="control-label"></label>
                <input asp-for="DonationDate" class="form-control" />
                <span asp-validation-for="DonationDate" class="text-danger"></span>
            </div>

            <!-- Submit button to trigger the update action and save changes back to local SSMS -->
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <!-- Link to return back to the list view without making or saving edits -->
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <!-- Renders client-side jQuery validation scripts asynchronously so form rules run smoothly in the browser -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}