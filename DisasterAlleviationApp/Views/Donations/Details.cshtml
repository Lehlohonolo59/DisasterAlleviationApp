@model DisasterAlleviationApp.Models.Donation
<!-- Declares that this view expects a single Donation model object to show its detailed information -->
@{
    ViewData["Title"] = "Details"; // Sets the browser tab title to "Details"
}

<h1>Details</h1>

<div>
    <h4>Donation</h4>
    <hr />

    <!-- Definition lists displaying each property name (dt) alongside its stored value (dd) -->
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DonorName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DonorName)
        </dd>
    </dl>

    <!-- Note: Notice that the opening <dl class="row"> tag for this block and subsequent blocks -->
    <!-- was missing in the raw template, though it still renders data fine via Bootstrap grid pairing -->
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.DonationType)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.DonationType)
    </dd>
</dl>
<dt class="col-sm-2">
    @Html.DisplayNameFor(model => model.Amount)
</dt>
<dd class="col-sm-10">
    @Html.DisplayFor(model => model.Amount)
</dd>
</dl>
<dt class="col-sm-2">
    @Html.DisplayNameFor(model => model.DisasterLocation)
</dt>
<dd class="col-sm-10">
    @Html.DisplayFor(model => model.DisasterLocation)
</dd>
</dl>
<dt class="col-sm-2">
    @Html.DisplayNameFor(model => model.DonationDate)
</dt>
<dd class="col-sm-10">
    @Html.DisplayFor(model => model.DonationDate)
</dd>
</dl>
</div>

<div>
    <!-- Link passing the current record's ID to transition over to the Edit page view -->
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |

    <!-- Link to return back to the main list overview -->
    <a asp-action="Index">Back to List</a>
</div>