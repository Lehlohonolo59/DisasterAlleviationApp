@model DisasterAlleviationApp.Models.Donation
<!-- Declares that this view receives a single Donation model object to display the record being targeted for deletion -->
@{
    ViewData["Title"] = "Delete"; // Sets the browser tab title to "Delete"
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<!-- Warning prompt asking the user to confirm their action before permanent removal -->

<div>
    <h4>DisasterAlleviationApp.Models.Donation</h4>
    <hr />

    <!-- Definition list displaying property labels (dt) and their respective record values (dd) for confirmation -->
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DonorName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DonorName)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DonationType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DonationType)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Amount)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DisasterLocation)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisasterLocation)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DonationDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DonationDate)
        </dd>
    </dl>

    <!-- Form that triggers the POST Delete action when confirmed -->
    <form asp-action="Delete">
        <!-- Hidden input field storing the unique record ID so the controller knows exactly which row to delete from SSMS -->
        <input type="hidden" asp-for="Id" />

        <!-- Red submit button to execute the deletion -->
        <input type="submit" value="Delete" class="btn btn-danger" /> |

        <!-- Link to cancel and return to the main list view -->
        <a asp-action="Index">Back to List</a>
    </form>
</div>